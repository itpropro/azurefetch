{
  "name": "azurefetch",
  "version": "0.2.0",
  "description": "Minimal dependency-free Azure fetch utilities",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prepare": "if command -v git >/dev/null 2>&1; then lefthook install; fi",
    "prepack": "bun run build",
    "build": "obuild",
    "dev": "vitest",
    "lint": "oxlint .",
    "lint:type": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix",
    "typecheck": "bun run lint:type",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:app-configuration": "AZUREFETCH_RUN_APP_CONFIGURATION_TESTS=1 vitest run test/app-configuration.integration.test.ts",
    "test:edge-smoke": "bun run test/edge-runtime-smoke.ts",
    "test:keyvault": "AZUREFETCH_RUN_KEYVAULT_TESTS=1 vitest run test/keyvault.integration.test.ts",
    "test:storage": "AZUREFETCH_RUN_STORAGE_TESTS=1 vitest run test/storage.integration.test.ts",
    "test:storage:azurite": "AZUREFETCH_RUN_STORAGE_TESTS=1 AZUREFETCH_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true vitest run test/storage.integration.test.ts",
    "bench:storage": "AZUREFETCH_RUN_STORAGE_BENCHMARK=1 bun run bench/storage.benchmark.ts",
    "bench:storage:azurite": "AZUREFETCH_RUN_STORAGE_BENCHMARK=1 AZUREFETCH_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true bun run bench/storage.benchmark.ts",
    "test:watch": "vitest",
    "release": "bunx changelogen --release --push",
    "publish:npm": "npm publish --access public",
    "check": "oxfmt --check && oxlint . && oxlint . --type-aware && vitest run && obuild && bun run test:edge-smoke"
  },
  "devDependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "12.33.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "lefthook": "^2.1.10",
    "obuild": "^0.4.38",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14"
}
