{
  "name": "azurefetch",
  "version": "0.5.0",
  "description": "Minimal dependency-free Azure fetch utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itpropro/azurefetch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "prepack": "bun run build",
    "build": "obuild",
    "dev": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:app-configuration": "AZUREFETCH_RUN_APP_CONFIGURATION_TESTS=1 vitest run test/app-configuration.integration.test.ts",
    "test:bun": "bun --bun vitest run test/client-certificate.test.ts",
    "test:edge-smoke": "bun run test/edge-runtime-smoke.ts",
    "test:keyvault": "AZUREFETCH_RUN_KEYVAULT_TESTS=1 vitest run test/keyvault.integration.test.ts",
    "test:storage": "AZUREFETCH_RUN_STORAGE_TESTS=1 vitest run test/storage.integration.test.ts",
    "test:storage:azurite": "AZUREFETCH_RUN_STORAGE_TESTS=1 AZUREFETCH_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true vitest run test/storage.integration.test.ts",
    "test:watch": "vitest",
    "release": "bunx changelogen --release --push",
    "stage:npm": "bash -c 'set -euo pipefail; if [[ $# -ne 1 || $1 != *.tgz ]]; then echo \"Usage: bun run stage:npm -- <package.tgz>\" >&2; exit 2; fi; npm stage publish \"$1\" --access public --ignore-scripts' --",
    "check": "oxfmt --check && oxlint && vitest run && bun run test:bun && obuild && bun run test:edge-smoke",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^26.6.5",
    "@visorian/code-standards": "^0.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "obuild": "^0.4.45",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.3"
}
